{
  "expo": {
    "name": "Sanidapp",
    "slug": "sanidapp",
    "version": "1.2.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sanidapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gr2206.sanidapp",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Sanidapp"
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "sanidapp",
              "host": "protocol"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "sanidapp",
              "host": "meeting"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "sanidapp",
              "host": "reset-password"
            },
            {
              "scheme": "sanidapp",
              "host": "forgot-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.gr2206.sanidapp",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#00B4D8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00B4D8",
          "defaultChannel": "foro-sum",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withDisableNotificationsBootActions",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 128,
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 128
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sanidapp necesita acceso a la cámara para escanear códigos QR de protocolos y para las salas de reunión.",
          "microphonePermission": "Sanidapp necesita el micrófono para las salas de reunión en vivo.",
          "recordAudioAndroid": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-calendar",
        {
          "calendarPermission": "Sanidapp guarda eventos del Foro en el calendario de tu celular cuando lo solicitás."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sanidapp usa tu ubicación solo para mostrar Cursos y Congresos si estás en Argentina."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sanidapp necesita acceso a tus fotos para adjuntar el flyer JPG/PNG de cursos y congresos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-iap",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-av",
      "expo-asset",
      "./plugins/withOptionalHardwareFeatures"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "645edc66-3198-43aa-a280-298151eda3c3"
      }
    },
    "owner": "g2206"
  }
}
