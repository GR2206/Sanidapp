rules_version = '2';
// NO DESPLEGAR en producción.
// Este archivo era un arranque temporal con write abierto.
// Usar siempre firestore.rules (estrictas). firebase.json apunta a firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
